{
  "name": "@slexisvn/quantc",
  "version": "0.1.0",
  "type": "module",
  "description": "A quant-finance pricing/risk compiler: the Quill payoff DSL to vectorised Monte Carlo and AAD Greeks",
  "keywords": [
    "quant",
    "finance",
    "monte-carlo",
    "risk",
    "derivatives",
    "aad",
    "quill"
  ],
  "license": "MIT",
  "author": "slexisvn",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/slexisvn/quantc.git"
  },
  "bugs": {
    "url": "https://github.com/slexisvn/quantc/issues"
  },
  "homepage": "https://github.com/slexisvn/quantc#readme",
  "main": "./dist/index.node.js",
  "module": "./dist/index.node.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "quantc": "./dist/index.cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "koffi": "^3.0.2"
  }
}
